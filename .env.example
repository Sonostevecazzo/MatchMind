# API-Football key: obtain it from your provider dashboard. Never commit a real key.
API_FOOTBALL_KEY=

# SQLite database path. Persistent local storage for fixtures, injuries, player stats and odds.
DATABASE_URL=sqlite:///./data/matchmind.db

# Automatic sync runs at 04:20 Europe/Rome while the MatchMind API process is running.
MATCHMIND_AUTO_SYNC=false
MATCHMIND_SYNC_ON_STARTUP=true
MATCHMIND_SYNC_HOUR=4
MATCHMIND_SYNC_MINUTE=20
MATCHMIND_TIMEZONE=Europe/Rome

# API-Football league IDs; 135 is the commonly used Serie A ID. Separate multiple IDs with commas.
MATCHMIND_LEAGUES=135
MATCHMIND_HISTORY_SEASONS=2
# Player stats can consume many requests. Enable only if the API plan/quota permits.
MATCHMIND_AUTO_SYNC_PLAYERS=false