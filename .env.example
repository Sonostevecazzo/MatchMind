# Optional API-Football key. Not required when using the public CSV source below.
# If used, never commit the real key or share it in chat.
API_FOOTBALL_KEY=

DATABASE_URL=sqlite:///./data/matchmind.db
MATCHMIND_TIMEZONE=Europe/Rome

# No-key public data mode: automatically refresh Serie A fixtures/results shortly after startup,
# then every day at 04:05 Europe/Rome while the MatchMind API process is running.
MATCHMIND_PUBLIC_AUTO_SYNC=true
MATCHMIND_PUBLIC_SYNC_ON_STARTUP=true
MATCHMIND_PUBLIC_SYNC_HOUR=4
MATCHMIND_PUBLIC_SYNC_MINUTE=5
MATCHMIND_PUBLIC_LEAGUES=ITA_1_serie-a
# Defaults to the current season start year (e.g. 2026 = season 2026/27).
# Set only if you want to pin a season:
# MATCHMIND_PUBLIC_SEASON=2026

# Optional API-Football sync is separate and remains disabled unless explicitly enabled.
MATCHMIND_AUTO_SYNC=false
MATCHMIND_SYNC_ON_STARTUP=true
MATCHMIND_SYNC_HOUR=4
MATCHMIND_SYNC_MINUTE=20
MATCHMIND_LEAGUES=135
MATCHMIND_HISTORY_SEASONS=2
MATCHMIND_AUTO_SYNC_PLAYERS=false

# Enable for any internet-accessible deployment. Set these as private environment secrets.
# If enabled without both credentials, requests fail closed (503).
MATCHMIND_REQUIRE_AUTH=false
MATCHMIND_AUTH_USERNAME=
MATCHMIND_AUTH_PASSWORD=
